# Normalise line endings so the repo stays LF regardless of who clones it.
# This is what silences the "LF will be replaced by CRLF" warnings on Windows.
* text=auto eol=lf

# Binary assets must never be normalised.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

# Keep lockfiles out of diffs on GitHub — they're noise in review.
package-lock.json linguist-generated=true -diff
