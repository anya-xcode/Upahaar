# Copy to server/.env and adjust.
PORT=5001
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/upahaar
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# --- Observability ---
# debug | info | warn | error | silent. Defaults to debug in development,
# info in production, silent under NODE_ENV=test.
LOG_LEVEL=
# Set to "json" to force one-JSON-object-per-line output in development too.
# Production is always JSON.
LOG_FORMAT=
# How long in-flight requests get to finish on SIGTERM before the process is
# forced out.
SHUTDOWN_GRACE_MS=10000

# --- Integrations ---
# Leave blank to run in simulated mode (checkout, uploads and maps are stubbed).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GOOGLE_MAPS_API_KEY=
