# Copy to server/.env and adjust.
PORT=5001
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/upahaar
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# --- Integrations ---
# Leave blank to run in simulated mode (checkout, uploads and maps are stubbed).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GOOGLE_MAPS_API_KEY=
